# ==========================================
# MAIL MCP SERVER CONFIGURATION
# ==========================================
# Copy this file to '.env' and fill in your credentials.
# DO NOT commit your actual '.env' file to version control.

# --- IMAP Configuration (Inbox, Search & Real-time IDLE) ---
# Gmail: imap.gmail.com | Port: 993 | Secure: true
# Outlook / Office365: outlook.office365.com | Port: 993 | Secure: true
# Custom cPanel / Webmail: mail.yourdomain.com | Port: 993 | Secure: true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@example.com
IMAP_PASS=your_app_password

# --- SMTP Configuration (Email Sending & Replying) ---
# Gmail: smtp.gmail.com | Port: 465 (SSL) or 587 (TLS) | Secure: true
# Outlook: smtp.office365.com | Port: 587 | Secure: false
# Custom cPanel / Webmail: mail.yourdomain.com | Port: 465 | Secure: true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# Sender Name and Optional From Address
SMTP_FROM_NAME="AI Mail Assistant"
# SMTP_FROM_ADDRESS=your_email@example.com

# Debug Logging (true / false)
DEBUG=false
