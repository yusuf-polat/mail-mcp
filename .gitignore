# ==========================================
# Mail MCP Server - Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
*.tsbuildinfo

# Downloaded files & quarantine area
downloads/
.quarantine/
*.log
logs/
temp/
tmp/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.agents/
.gemini/
